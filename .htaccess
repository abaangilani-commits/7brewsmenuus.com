DirectoryIndex index.html
Options -MultiViews
RewriteEngine On

# www -> apex (single canonical host)
RewriteCond %{HTTP_HOST} ^www\.7brewsmenuus\.com$ [NC]
RewriteRule ^(.*)$ https://7brewsmenuus.com/$1 [R=301,L]

# /index or /index.html -> /
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index(\.html)?[\s?] [NC]
RewriteRule ^ /? [R=301,L]

# /page.html -> /page  (index handled above)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^\s?]+)\.html[\s?] [NC]
RewriteCond %1 !^index$ [NC]
RewriteRule ^ /%1 [R=301,L,QSA]

# Internally serve page.html when /page is requested and no real file/dir matches
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [L]

ErrorDocument 404 /404.html

# --- Performance: text compression + static asset caching ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
